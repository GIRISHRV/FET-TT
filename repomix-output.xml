# QuickBell Data Sync
# Runs every 6 hours (and on manual trigger).
# Fetches the timetable HTML from ktiwari.in, extracts the JSON blob,
# writes it to js/data.js, and commits + pushes if changed.
# GitHub Pages auto-redeploys on push.

name: Sync Timetable Data

on:
  schedule:
    # Every 6 hours: midnight, 6am, noon, 6pm IST (offset by -5:30)
    - cron: '30 18,0,6,12 * * *'
  workflow_dispatch: # manual trigger button in Actions tab

permissions:
  contents: write

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Fetch & extract timetable data
        run: |
          python - <<'PYEOF'
          import urllib.request, json, re

          URL = "http://ktiwari.in/webTT/"
          print(f"Fetching {URL}...")
          req = urllib.request.Request(URL, headers={"User-Agent": "QuickBell-Sync/1.0"})
          html = urllib.request.urlopen(req, timeout=30).read().decode("utf-8")

          # Extract JSON from <script id="batch-data" type="application/json">...</script>
          match = re.search(
              r'<script[^>]+id=["\']batch-data["\'][^>]*>(.*?)</script>',
              html, re.DOTALL
          )
          if not match:
              raise RuntimeError("Could not find batch-data script tag in HTML")

          raw_json = match.group(1).strip()
          data = json.loads(raw_json)  # validate it's real JSON

          # Write as window.BATCH_DATA = {...};
          out = f"window.BATCH_DATA = {json.dumps(data, separators=(',', ':'))};\n"
          with open("js/data.js", "w", encoding="utf-8") as f:
              f.write(out)

          programs = len(data.get("programs", []))
          batches = len(data.get("batches", {}))
          print(f"Extracted {programs} programs, {batches} batch entries.")
          PYEOF

      - name: Check for changes
        id: diff
        run: |
          git diff --quiet js/data.js && echo "changed=false" >> $GITHUB_OUTPUT || echo "changed=true" >> $GITHUB_OUTPUT

      - name: Commit & push if changed
        if: steps.diff.outputs.changed == 'true'
        run: |
          git config user.name "QuickBell Bot"
          git config user.email "bot@quickbell.app"
          git add js/data.js
          git commit -m "data: sync timetable $(date -u +%Y-%m-%dT%H:%M:%SZ)"
          git push
</file>

<file path=".github/workflows/update-data.yml">
name: Update & Deploy Timetable App

on:
  schedule:
    - cron: '0 0 * * *'
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: write
  pages: write
  id-token: write

concurrency:
  group: "pages"
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.x'

      - name: Fetch latest data
        run: python scripts/fetch_data.py

      - name: Commit data changes
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add public/data.json
          git diff --quiet && git diff --staged --quiet || (git commit -m "Auto-update timetable data" && git push)

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Build Vite App
        run: npm run build
        
      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: ./dist

  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
</file>

