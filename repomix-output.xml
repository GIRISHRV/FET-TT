<file path="scripts/fetch_data.py">
import urllib.request
import json
import os

URL = 'http://ktiwari.in/webTT/'
MARKER = '<script id="batch-data" type="application/json">'

def main():
    print(f"Fetching {URL}...")
    try:
        req = urllib.request.Request(URL, headers={'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)'})
        with urllib.request.urlopen(req) as response:
            html = response.read().decode('utf-8')
    except Exception as e:
        print(f"Error fetching URL: {e}")
        exit(1)

    start = html.find(MARKER)
    if start == -1:
        print("Could not find marker in HTML.")
        exit(1)
        
    start += len(MARKER)
    end = html.find('</script>', start)
    
    if end == -1:
        print("Could not find closing script tag.")
        exit(1)
        
    json_data = html[start:end].strip()
    
    try:
        parsed = json.loads(json_data)
        print(f"Successfully parsed JSON! Programs: {len(parsed.get('programs', []))}, Batches: {len(parsed.get('batches', {}))}")
    except json.JSONDecodeError as e:
        print(f"Failed to parse JSON: {e}")
        exit(1)
        
    # Write to public/data.json
    target_dir = os.path.join(os.path.dirname(os.path.dirname(__file__)), 'public')
    os.makedirs(target_dir, exist_ok=True)
    target_path = os.path.join(target_dir, 'data.json')
    
    with open(target_path, 'w', encoding='utf-8') as f:
        json.dump(parsed, f, indent=2)
        
    print(f"Successfully updated {target_path}")

if __name__ == '__main__':
    main()
