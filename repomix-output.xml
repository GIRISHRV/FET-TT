import React from 'react';
import { 
  Box, Typography, Paper, Table, TableBody, 
  TableCell, TableContainer, TableHead, TableRow 
} from '@mui/material';
import { useAppStore } from '../store';

export default function CoursesPanel() {
  const { currentBatch, selectedSubjects } = useAppStore();

  if (!currentBatch) return null;

  return (
    <Box sx={{ display: 'flex', flexDirection: 'column', gap: 2, height: '100%' }}>
      <Typography variant="body1" color="text.secondary" sx={{ mb: 1 }}>
        Your courses for this semester. You can edit your electives in Settings.
      </Typography>

      <TableContainer component={Paper} sx={{ borderRadius: 1, bgcolor: 'background.surfaceContainerLow', overflowX: 'auto' }}>
        <Table size="small" sx={{ minWidth: 400 }} aria-label="courses table">
          <TableHead>
            <TableRow>
              <TableCell sx={{ fontWeight: 'bold' }}>ID</TableCell>
              <TableCell sx={{ fontWeight: 'bold' }}>Name</TableCell>
              <TableCell sx={{ fontWeight: 'bold' }}>Faculty</TableCell>
            </TableRow>
          </TableHead>
          <TableBody>
            {currentBatch.subjects.map((sub) => {
              // Since type metadata is missing, all subjects are togglable
              const isSelected = selectedSubjects.includes(sub.code);

              return (
                <TableRow 
                  key={sub.code}
                  sx={{ 
                    opacity: isSelected ? 1 : 0.5,
                    '&:last-child td, &:last-child th': { border: 0 }
                  }}
                >
                  <TableCell sx={{ whiteSpace: 'nowrap' }}>{sub.code}</TableCell>
                  <TableCell>{sub.name}</TableCell>
                  <TableCell>{sub.faculty || '-'}</TableCell>
                </TableRow>
              );
            })}
          </TableBody>
        </Table>
      </TableContainer>
    </Box>
  );
}
</file>

<file path="src/components/FacultyPanel.jsx">
import React, { useMemo, useState } from 'react';
import { 
  Box, Typography, Paper, Table, TableBody, TableCell, 
  TableContainer, TableHead, TableRow, Collapse, Chip 
} from '@mui/material';
import KeyboardArrowDownIcon from '@mui/icons-material/KeyboardArrowDown';
import KeyboardArrowUpIcon from '@mui/icons-material/KeyboardArrowUp';
import { useAppStore } from '../store';
import { formatTime12h, getTodayDayName, parseSlotText, PERIODS } from '../utils';

function getFacultyGlobalSchedule(data, facultyName) {
  const schedule = { Mon: [], Tue: [], Wed: [], Thu: [], Fri: [], Sat: [], Sun: [] };
  if (!data || !data.batches || !facultyName) return schedule;

  for (const batchKey in data.batches) {
    const batch = data.batches[batchKey];
    if (!batch.subjects || !batch.grid) continue;
    
    // Find subject codes this faculty teaches in this batch
    const codes = batch.subjects
      .filter(s => s.faculty && s.faculty.includes(facultyName))
      .map(s => s.code);
      
    if (codes.length === 0) continue;
    
    for (const day in batch.grid) {
      const slots = batch.grid[day];
      for (const slotIdx in slots) {
        const slot = slots[slotIdx];
        if (slot.type === 'free' || slot.type === 'lunch') continue;
        if (codes.some(code => slot.text && slot.text.startsWith(code))) {
          // Verify we aren't adding duplicates for the same period
          const periodIndex = Number(slotIdx) - 1;
          const exists = schedule[day].find(s => s.periodIndex === periodIndex);
          if (!exists) {
            schedule[day].push({
              periodIndex,
              text: slot.text,
              batch: batchKey
            });
          }
        }
      }
    }
  }
  
  // Sort the schedule periods for each day
  for (const day in schedule) {
    schedule[day].sort((a, b) => a.periodIndex - b.periodIndex);
  }
  
  return schedule;
}

function FacultyRow({ facultyName, subjectCode, subjectName, data }) {
  const [expanded, setExpanded] = useState(false);
  
  const schedule = useMemo(() => getFacultyGlobalSchedule(data, facultyName), [data, facultyName]);
  
  const now = new Date();
  const currentDayStr = getTodayDayName();
  const daySchedule = schedule[currentDayStr] || [];
  
  const currentMins = now.getHours() * 60 + now.getMinutes();
  const currentPeriodIdx = PERIODS.findIndex(p => p.start <= currentMins && p.end >= currentMins);
  
  let status = 'Free';
  let statusText = 'Free right now';
  let busySlot = null;
  
  if (currentPeriodIdx !== -1) {
    busySlot = daySchedule.find(s => s.periodIndex === currentPeriodIdx);
    if (busySlot) {
      status = 'Busy';
      const parsed = parseSlotText(busySlot.text);
      statusText = `Busy in ${parsed?.room || 'Class'}`;
    }
  }
  
  let nextFreeText = 'Free rest of day';
  if (status === 'Busy') {
    for (let i = currentPeriodIdx + 1; i < PERIODS.length; i++) {
      const busy = daySchedule.find(s => s.periodIndex === i);
      if (!busy) {
        nextFreeText = `Free next at ${formatTime12h(PERIODS[i].start)}`;
        break;
      }
    }
  } else {
    // If free now, when is next class?
    let nextClassIdx = -1;
    for (let i = Math.max(0, currentPeriodIdx + 1); i < PERIODS.length; i++) {
      const busy = daySchedule.find(s => s.periodIndex === i);
      if (busy) {
        nextClassIdx = i;
        break;
      }
    }
    if (nextClassIdx !== -1) {
      nextFreeText = `Busy next at ${formatTime12h(PERIODS[nextClassIdx].start)}`;
    }
  }

  return (
    <>
      <TableRow 
        onClick={() => setExpanded(!expanded)} 
        sx={{ 
          cursor: 'pointer', 
          '&:last-child td, &:last-child th': { border: expanded ? 1 : 0 },
          '& > *': { borderBottom: 'unset' },
          bgcolor: expanded ? 'background.surfaceContainerHigh' : 'inherit',
          transition: 'background-color 0.2s'
        }}
      >
        <TableCell>
          <Typography variant="body1" fontWeight="medium">{facultyName}</Typography>
          <Typography variant="caption" color="text.secondary">{subjectCode} - {subjectName}</Typography>
        </TableCell>
        <TableCell>
          <Chip 
            label={statusText} 
            size="small" 
            color={status === 'Free' ? 'success' : 'error'} 
            variant={status === 'Free' ? 'outlined' : 'filled'}
            sx={{ fontWeight: 'bold' }}
          />
        </TableCell>
        <TableCell>
          <Typography variant="body2" color="text.secondary">
            {nextFreeText}
          </Typography>
        </TableCell>
        <TableCell align="right" sx={{ py: 0 }}>
          {expanded ? <KeyboardArrowUpIcon /> : <KeyboardArrowDownIcon />}
        </TableCell>
      </TableRow>
      <TableRow>
        <TableCell style={{ paddingBottom: 0, paddingTop: 0 }} colSpan={4}>
          <Collapse in={expanded} timeout="auto" unmountOnExit>
            <Box sx={{ p: 2, bgcolor: 'background.surfaceContainer', borderRadius: 2, mb: 2, mt: 1 }}>
              <Typography variant="subtitle2" gutterBottom color="text.secondary" sx={{ textTransform: 'uppercase' }}>
                {currentDayStr}'s Schedule (Across College)
              </Typography>
              {daySchedule.length === 0 ? (
                <Typography variant="body2">No classes scheduled for today.</Typography>
              ) : (
                <Table size="small" aria-label="faculty-schedule">
                  <TableBody>
                    {daySchedule.map(slot => {
                      const period = PERIODS[slot.periodIndex];
                      const parsed = parseSlotText(slot.text);
                      const isCurrent = slot.periodIndex === currentPeriodIdx;
                      return (
                        <TableRow key={slot.periodIndex} sx={{ opacity: slot.periodIndex < currentPeriodIdx ? 0.5 : 1 }}>
                          <TableCell sx={{ pl: 0, borderBottom: 'none' }}>
                            <Typography variant="caption" color={isCurrent ? 'primary' : 'text.secondary'} fontWeight={isCurrent ? 'bold' : 'normal'}>
                              {formatTime12h(period.start)} - {formatTime12h(period.end)}
                            </Typography>
                          </TableCell>
                          <TableCell sx={{ borderBottom: 'none' }}>
                            <Typography variant="body2" fontWeight={isCurrent ? 'bold' : 'normal'}>
                              {parsed ? parsed.code : slot.text} 
                            </Typography>
                            <Typography variant="caption" color="text.secondary">
                              Batch: {slot.batch.replace(/\|/g, ' ')}
                            </Typography>
                          </TableCell>
                          <TableCell sx={{ pr: 0, borderBottom: 'none', textAlign: 'right' }}>
                            <Typography variant="body2">
                              {parsed ? parsed.room : '-'}
                            </Typography>
                          </TableCell>
                        </TableRow>
                      );
                    })}
                  </TableBody>
                </Table>
              )}
            </Box>
          </Collapse>
        </TableCell>
      </TableRow>
    </>
  );
}

export default function FacultyPanel() {
  const { currentBatch, selectedSubjects, data } = useAppStore();

  if (!currentBatch) return null;

  // Since type metadata is missing, we consider all subjects in the batch.
  // We can filter to only show faculties of subjects the user is actually taking.
  const activeSubjects = currentBatch.subjects.filter(sub => selectedSubjects.includes(sub.code));

  return (
    <Box sx={{ display: 'flex', flexDirection: 'column', gap: 2, height: '100%' }}>
      <Typography variant="body1" color="text.secondary" sx={{ mb: 1 }}>
        Your faculty members for this semester. Click on a faculty to view their availability today.
      </Typography>

      <TableContainer component={Paper} sx={{ borderRadius: 1, bgcolor: 'background.surfaceContainerLow', overflowX: 'auto' }}>
        <Table size="small" sx={{ minWidth: 400 }} aria-label="faculty table">
          <TableHead>
            <TableRow>
              <TableCell sx={{ fontWeight: 'bold' }}>Faculty Name</TableCell>
              <TableCell sx={{ fontWeight: 'bold' }}>Current Status</TableCell>
              <TableCell sx={{ fontWeight: 'bold' }}>Next Available</TableCell>
              <TableCell />
            </TableRow>
          </TableHead>
          <TableBody>
            {activeSubjects.map((sub) => {
              if (!sub.faculty) return null;
              
              const faculties = sub.faculty.split(',').map(f => f.trim()).filter(Boolean);
              
              return faculties.map((facultyName, idx) => (
                <FacultyRow 
                  key={`${sub.code}-${idx}`} 
                  facultyName={facultyName} 
                  subjectCode={sub.code}
                  subjectName={sub.name}
                  data={data}
                />
              ));
            })}
          </TableBody>
        </Table>
      </TableContainer>
    </Box>
  );
}
